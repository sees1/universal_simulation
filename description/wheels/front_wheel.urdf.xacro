<robot name="front_wheel" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="front_wheel_width" value="0.20" />
    <xacro:property name="front_wheel_radius" value="0.385" />
    <xacro:property name="front_wheel_mass" value="40.0" />

    <xacro:include filename="$(find universal_simulation)/description/inertials.xacro"/>

    <!-- link -->
    <xacro:macro name="front_wheel_link" params="lat_label reflect">
        <link name="front_${lat_label}_wheel_link">
            <visual>
                <origin rpy="${reflect * (-1) * math_pi_over_2} 0 0" xyz="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find universal_simulation)/meshes/wheels/front_wheel.stl"/>
                </geometry>
                <material name="black" />
            </visual>
            <collision>
                <origin rpy="${reflect * (-1) * math_pi_over_2} 0 0" xyz="0 0 0" />
                <geometry>
                    <cylinder length="${front_wheel_width}" radius="${front_wheel_radius}" />
                </geometry>
            </collision>
            <xacro:solid_cylinder_inertial
                rpy="${reflect * (-1) * math_pi_over_2} 0 0" xyz="0 0 0"
                mass="${front_wheel_mass}"
                radius="${front_wheel_radius}" length="${front_wheel_width}" />
        </link>

        <gazebo reference="front_${lat_label}_wheel_link">
            <material>Gazebo/DarkGray</material>
			<mu1 value="100.0"/>
			<mu2 value="100.0"/>
			<kp value="10000000.0" />
			<kd value="1.0" />
			<fdir1 value="1 0 0"/>
            <turnGravityOff>false</turnGravityOff>
        </gazebo>
    </xacro:macro>
    <!-- <origin rpy="${reflect * (-1) * math_pi_over_2} 0 0" xyz="0 0 0" /> -->


    <!-- front wheel joint -->
    <xacro:macro name="front_wheel_joint" params="lat_label reflect">
        <joint name="front_${lat_label}_wheel_joint" type="continuous">
            <origin rpy="${reflect * -1 * 0.12} 0 0" xyz="0 ${reflect * 0.1} -0.06"/>
            <axis xyz="0 1 0" />
            <parent link="${lat_label}_knuckle_link" />
            <child link="front_${lat_label}_wheel_link" />
            <limit effort="1000.0" lower="-3.14159" upper="3.14159" velocity="30"/>
            <dynamics damping="0.0" friction="0.0"/>
        </joint>

        <gazebo reference="front_${lat_label}_wheel_joint">
            <provideFeedback>true</provideFeedback>
        </gazebo>
    </xacro:macro>
</robot>