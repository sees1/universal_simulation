<robot name="rear_wheel" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="rear_wheel_width" value="0.32" />
    <xacro:property name="rear_wheel_radius" value="0.615" />
    <xacro:property name="rear_wheel_mass" value="70.0" />

    <xacro:include filename="$(find universal_simulation)/description/inertials.xacro"/>

    <!-- link -->
    <xacro:macro name="rear_wheel_link" params="lat_label reflect">
        <link name="rear_${lat_label}_wheel_link">
            <visual>
                <origin rpy="${reflect * (-1) * math_pi_over_2} 0 0" xyz="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find universal_simulation)/meshes/wheels/rear_wheel.stl"/>
                </geometry>
                <material name="black" />
            </visual>
            <collision>
                <origin rpy="${reflect * (-1) * math_pi_over_2} 0 0" xyz="0 0 0" />
                <geometry>
                    <cylinder length="${rear_wheel_width}" radius="${rear_wheel_radius}" />
                </geometry>
            </collision>
            <xacro:solid_cylinder_inertial
                rpy="${reflect * (-1) * math_pi_over_2} 0 0" xyz="0 0 0"
                mass="${rear_wheel_mass}"
                radius="${rear_wheel_radius}" length="${rear_wheel_width}" />
        </link>    

        <gazebo reference="rear_${lat_label}_wheel_link">
            <material>Gazebo/DarkGray</material>
            <mu1 value="1.0"/>
            <mu2 value="1.0"/>
            <kp value="10000000.0" />
            <kd value="1.0" />
            <fdir1 value="1 0 0"/>
            <turnGravityOff>false</turnGravityOff>
        </gazebo>
    </xacro:macro>


    <!-- rear wheel joint -->
    <xacro:macro name="rear_wheel_joint" params="lat_label reflect">
        <joint name="rear_${lat_label}_wheel_joint" type="continuous">
            <origin rpy="0 0 0" xyz="-0.31 ${reflect * 0.72} -0.92"/>
            <axis xyz="0 1 0" />
            <parent link="body_box_link" />
            <child link="rear_${lat_label}_wheel_link" />
            <limit effort="1000.0" velocity="30"/>
            <dynamics damping="0.0" friction="0.0"/>
        </joint>

        <gazebo reference="rear_${lat_label}_wheel_joint">
            <provideFeedback>true</provideFeedback>
        </gazebo>
    </xacro:macro>
</robot>