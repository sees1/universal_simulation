<robot name="knuckle" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="knuckle_cylinder_radius" value="0.33" />
    <xacro:property name="knuckle_cylinder_length" value="0.53" />
    <xacro:property name="knuckle_cylinder_mass" value="45.0" />

    <xacro:include filename="$(find universal_simulation)/description/inertials.xacro"/>

    <xacro:macro name="knuckle" params="lat_label reflect">

        <!-- link -->
        <link name="${lat_label}_knuckle_link">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find universal_simulation)/meshes/bases2/steering_knuckle_${lat_label}.stl"/>
                </geometry>
                <material name="white" />
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find universal_simulation)/meshes/bases2/steering_knuckle_${lat_label}.stl"/>
                </geometry>
            </collision>
            <xacro:solid_cylinder_inertial 
                rpy="0 0 0" xyz="0 0 0"
                mass="${knuckle_cylinder_mass}"
                radius="${knuckle_cylinder_radius}" length="${knuckle_cylinder_length}" />
        </link>

        <gazebo reference="${lat_label}_bogie_link">
            <material>Gazebo/White</material>
        </gazebo>


        <!-- joint -->
        <joint name="${lat_label}_knuckle_joint" type="revolute">
            <origin rpy="${reflect * 0.12} 0 0" xyz="0 ${reflect * 0.505} -0.23"/>
            <axis xyz="0 0 1" />
            <limit 
                lower="${-math_pi_over_4}"
                upper="${math_pi_over_4}"
                effort="100.0"
                velocity="30.0" />
            <parent link="front_axle_link" />
            <child link="${lat_label}_knuckle_link" />
        </joint>

        <gazebo reference="${lat_label}_knuckle_joint">
            <provideFeedback>true</provideFeedback>
            <implicitSpringDamper>true</implicitSpringDamper>
        </gazebo>
    </xacro:macro>
</robot>