<robot name="front_axle" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="axle_box_length" value="0.348" />
    <xacro:property name="axle_box_width" value="1.05" />
    <xacro:property name="axle_box_depth" value="0.2" />
    <xacro:property name="axle_box_mass" value="100.0" />

    <xacro:include filename="$(find universal_simulation)/description/inertials.xacro"/>

    <xacro:macro name="front_axle" params="parent">

        <link name="front_axle_link">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find universal_simulation)/meshes/bases2/front_axle.stl"/>
                </geometry>
                <material name="white"/>
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find universal_simulation)/meshes/bases2/front_axle.stl"/>
                </geometry>
            </collision>
            <xacro:solid_cuboid_inertial 
                rpy="0 0 0" xyz="0 0 0"
                mass="${axle_box_mass}"
                x="${axle_box_length}" y="${axle_box_width}" z="${axle_box_depth}" />
        </link>

        <gazebo reference="front_axle_link">
            <material>Gazebo/White</material>
        </gazebo>

        <joint name="front_axle_joint" type="revolute">
            <origin rpy="0 0 0" xyz="2.22 0.0028 -0.855"/>
            <axis xyz="1 0 0" />
            <limit 
                lower="${-math_pi_over_16}"
                upper="${math_pi_over_16}"
                effort="100.0"
                velocity="30.0" />
            <parent link="${parent}" />
            <child link="front_axle_link" />
        </joint>

        <gazebo reference="front_axle_joint">
            <provideFeedback>true</provideFeedback>
            <implicitSpringDamper>true</implicitSpringDamper>
        </gazebo>

    </xacro:macro>
</robot>