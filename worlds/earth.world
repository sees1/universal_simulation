<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <scene>
      <background>0.792 0.588 0.259 1</background>
    </scene>
    <light type="directional" name="directional_light_1">
      <pose>0 20 20 0.1 0.1 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>1 1 1 1</specular>
      <attenuation>
        <range>300</range>
      </attenuation>
      <direction>0.1 0.1 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <physics type="ode">
        <max_step_size>0.001</max_step_size>
        <gravity>0 0 -9.11</gravity>     <!-- Earth Gravity -->
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://cols_group</uri>
      <name>cols_group</name>
      <pose>0 0 3.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://terrain</uri>
      <name>terrain</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
